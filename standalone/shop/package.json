{
  "name": "seller-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "start": "node scripts/start.mjs",
    "api": "node --env-file-if-exists=.env.local server/index.js",
    "test:api": "node --test tests/manual-orders.test.mjs",
    "test:worker": "node --test tests/worker-api.test.mjs",
    "test:mail": "node --test tests/reset-mail.test.mjs",
    "test:ui": "vitest run",
    "test:sites": "node --test tests/sites-worker.test.mjs tests/admin-entry.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "express": "^5.2.1",
    "lucide-react": "^1.47.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "miniflare": "^5.20260918.0-alpha",
    "vitest": "^5.0.1"
  }
}
