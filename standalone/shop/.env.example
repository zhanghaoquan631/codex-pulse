ADMIN_PASSWORD=replace-with-a-unique-long-password
PORT=8787
# Set these behind an HTTPS reverse proxy in production:
# NODE_ENV=production
# TRUST_PROXY=true
# CORS_ORIGIN=https://your-domain.example
# STORE_PATH=/data/store.json
# UPLOADS_PATH=/data/uploads

# Keep disabled until a public HTTPS origin, SMTP credentials, and delivery are verified.
MAIL_ENABLED=false
# PUBLIC_ORIGIN=https://your-domain.example
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_USER=your-verified-sender@163.com
# SMTP_PASS=your-smtp-authorization-code
# MAIL_STORE_PATH=/data/subscriptions.json
