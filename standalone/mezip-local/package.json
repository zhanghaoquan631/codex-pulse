{
  "name": "me-zip",
  "version": "0.0.0",
  "private": true,
  "description": "ME.zip — Archive Your Life.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.14.0",
    "pnpm": ">=11.19.0"
  },
  "scripts": {
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e",
    "test:unit": "vitest run --exclude '**/dist/**' --exclude 'tests/integration/**' --exclude 'tests/e2e/**'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "build": "pnpm -r --if-present run build",
    "format:check": "prettier --check .",
    "audit:interactions": "node scripts/audit-interactions.mjs",
    "audit:migrations": "node scripts/validate-migrations.mjs",
    "audit:secrets": "node scripts/scan-secrets.mjs",
    "audit:production": "pnpm audit:migrations && pnpm audit:secrets"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.15"
  }
}
