{
  "name": "@me-zip/github-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./api": {
      "types": "./src/api.ts",
      "default": "./src/api.ts"
    }
  },
  "dependencies": {
    "@me-zip/shared-types": "workspace:*"
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src --passWithNoTests",
    "build": "tsc -p tsconfig.build.json",
    "dev:server": "pnpm build && node dist/local-dev-server.js"
  }
}
