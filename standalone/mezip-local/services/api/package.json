{
  "name": "@me-zip/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@me-zip/ai-gateway": "workspace:*",
    "@me-zip/analytics": "workspace:*",
    "@me-zip/archive": "workspace:*",
    "@me-zip/community": "workspace:*",
    "@me-zip/creator-ecosystem": "workspace:*",
    "@me-zip/creator-lab": "workspace:*",
    "@me-zip/deployment": "workspace:*",
    "@me-zip/external-identity": "workspace:*",
    "@me-zip/messaging": "workspace:*",
    "@me-zip/payment": "workspace:*",
    "@me-zip/personal-ai": "workspace:*",
    "@me-zip/release-management": "workspace:*",
    "@me-zip/sandbox-runtime": "workspace:*",
    "@me-zip/social-connector-x": "workspace:*",
    "@me-zip/social-connectors": "workspace:*",
    "@me-zip/shared-types": "workspace:*",
    "@me-zip/utils": "workspace:*"
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
