{
  "name": "tom-profile-card-triple-v15",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5173 --strictPort",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "serve": "node --disable-warning=ExperimentalWarning ./server/server.mjs",
    "start": "npm run build && npm run serve",
    "test:auth": "node ./scripts/auth-smoke-test.mjs",
    "test:security": "node ./scripts/security-smoke-test.mjs",
    "test:brevo": "node ./scripts/test-brevo-email.mjs",
    "test:gmail": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-gmail-password-normalization.ps1 && node ./scripts/test-email-errors.mjs && node ./scripts/test-gmail-smtp.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.4",
    "@react-three/fiber": "^9.3.0",
    "@react-three/rapier": "^2.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "express": "^5.2.1",
    "meshline": "^3.3.1",
    "nodemailer": "^10.0.0",
    "ogl": "^1.0.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "vite": "^6.3.5"
  }
}
